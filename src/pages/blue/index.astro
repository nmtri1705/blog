---
import SectionListing from "@/components/blog/SectionListing.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
const posts = (await getAllPosts())
	.filter((post) => post.data.section === "blue")
	.sort(collectionDateSort);
const description =
	"Investigating alerts, hunting threats, malware analyst and uncovering digital evidence.";
---

<PageLayout meta={{ title: "Blue", description }}>
	<SectionListing title="Blue" description={description} posts={posts} />
</PageLayout>
