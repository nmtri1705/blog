---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import SectionListing from "@/components/blog/SectionListing.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getAllPosts())
		.filter((post) => post.data.section === "posts")
		.sort(collectionDateSort);
	return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;
interface Props {
	page: Page<CollectionEntry<"post">>;
}
const { page } = Astro.props;
const description = "CTF write-ups, solved challenges, and lessons learned along the way.";
const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← Previous page", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "Next page →", url: page.url.next } }),
};
---

<PageLayout meta={{ title: "Posts", description }}>
	<SectionListing title="Posts" description={description} posts={page.data} />
	<Pagination {...paginationProps} />
</PageLayout>
