---
import PostCard from "@/components/blog/PostCard.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
const posts = (await getAllPosts()).sort(collectionDateSort);
const pinnedPosts = posts.filter((post) => post.data.pinned).slice(0, 3);
const latestPosts = posts.filter((post) => post.data.section === "posts").slice(0, 5);
const latestBlue = posts.filter((post) => post.data.section === "blue").slice(0, 3);
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<p class="text-accent mb-3 text-xs tracking-widest uppercase">
			Cybersecurity / Digital forensics
		</p>
		<h1 class="title mb-6">Hi, I'm iris.</h1>
		<p class="mb-4 leading-7">
			I'm a Digital Forensics enthusiast studying at the University of Information Technology.
		</p>
		<p class="text-muted mb-6 leading-7">
			Welcome to my blog! This is where I share what I learn
			about cybersecurity.
		</p>
		<SocialList />
	</section>
	{pinnedPosts.length > 0 && (
		<section class="mt-14">
			<h2 class="title mb-6 text-xl">Pinned</h2>
			<ul class="space-y-5" role="list">
				{pinnedPosts.map((post) => (
					<li>
						<PostCard post={post} />
					</li>
				))}
			</ul>
		</section>
	)}
	<section class="mt-14">
		<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
			<h2 class="title text-xl">Latest posts</h2>
			<a class="cactus-link text-accent" href="/posts/">
				All posts →
			</a>
		</div>
		{latestPosts.length ? (
			<ul class="space-y-5" role="list">
				{latestPosts.map((post) => (
					<li>
						<PostCard post={post} />
					</li>
				))}
			</ul>
		) : (
			<p class="text-muted">CTF write-ups are on the way.</p>
		)}
	</section>
	<section class="mt-14">
		<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
			<h2 class="title text-xl">Blue team labs</h2>
			<a class="cactus-link text-accent" href="/blue/">
				Explore Blue →
			</a>
		</div>
		{latestBlue.length ? (
			<ul class="space-y-5" role="list">
				{latestBlue.map((post) => (
					<li>
						<PostCard post={post} />
					</li>
				))}
			</ul>
		) : (
			<p class="text-muted">Hands-on investigations and blue team labs.</p>
		)}
	</section>
	<p class="mt-12">
		<a class="cactus-link text-accent" href="/archive/">
			Browse the full archive →
		</a>
	</p>
</PageLayout>
