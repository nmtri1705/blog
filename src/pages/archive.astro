---
import FormattedDate from "@/components/FormattedDate.astro";
import { getAllPosts, getPostUrl } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
const posts = (await getAllPosts()).sort(collectionDateSort);
const grouped = Object.groupBy(posts, (post) => String(post.data.publishDate.getUTCFullYear()));
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<PageLayout
	meta={{
		title: "Archive",
		description: "All CTF write-ups and blue team labs, from newest to oldest.",
	}}
>
	<h1 class="title mb-3">Archive</h1>
	{!posts.length && <p class="text-muted">Nothing published yet. Check back soon.</p>}
	{years.map((year) => (
		<section class="mb-12" aria-labelledby={`year-${year}`}>
			<h2 id={`year-${year}`} class="title mb-6 text-xl">
				{year}
			</h2>
			<ol class="timeline">
				{grouped[year]?.map((post) => (
					<li>
						<div class="entry-meta">
							<FormattedDate date={post.data.publishDate} />
						</div>
						<h3>
							<a class="cactus-link" href={getPostUrl(post)}>
								{post.data.draft && "[Draft] "}
								{post.data.title}
							</a>
						</h3>
					</li>
				))}
			</ol>
		</section>
	))}
</PageLayout>
<style>
	.timeline {
		border-left: 1px solid color-mix(in srgb, var(--color-muted) 35%, transparent);
		margin-left: 0.4rem;
	}
	.timeline li {
		display: grid;
		gap: 0.5rem 1.5rem;
		position: relative;
		padding: 0 0 2rem 1.75rem;
	}
	.timeline li:last-child {
		padding-bottom: 0.5rem;
	}
	.timeline li::before {
		content: "";
		position: absolute;
		left: -0.3rem;
		top: 0.4rem;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 0 4px var(--color-global-bg);
	}
	.entry-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		font-size: 0.75rem;
		color: var(--color-muted);
	}
	@media (min-width: 640px) {
		.timeline li {
			grid-template-columns: 8rem minmax(0, 1fr);
			align-items: baseline;
		}
	}
	h3 {
		font-size: 1rem;
		font-weight: 600;
	}
</style>
