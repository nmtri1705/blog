---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}
const {
	heading: { children, slug, text },
} = Astro.props;
---

<li>
	<a href={`#${encodeURIComponent(slug)}`} data-toc-id={slug}>
		{text}
	</a>
	{children.length > 0 && (
		<ol>
			{children.map((heading) => (
				<Astro.self heading={heading} />
			))}
		</ol>
	)}
</li>
